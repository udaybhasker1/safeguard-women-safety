# Copy this file to ".env" (in the backend folder) and fill in your own values.
# Never commit ".env".

# Login tokens are signed with this. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "development" locally, "production" when deployed
APP_ENV=development

# Twilio (SMS + WhatsApp). Leave empty to run in simulated mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: only if the frontend is hosted on a different domain
# ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional: where the SQLite file lives
# DB_PATH=/data/safeguard.db
